# Slack API Tokens (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Admin Configuration (required)
ADMIN_USER_IDS=U123456,U789012
ADMIN_REVIEW_CHANNEL=C123456789

# Optional Configuration
AUDIT_LOG_CHANNEL=C987654321

# Set to "true" to allow anyone in the admin channel to approve/deny
# Set to "false" (default) to only allow users in ADMIN_USER_IDS
ALLOW_ALL_CHANNEL_MEMBERS=false

PORT=3000

# Database Configuration (optional for local development)
# Leave DATABASE_URL unset for local development (uses SQLite automatically)
# For production (Railway/Heroku), this is set automatically by the platform
# DATABASE_URL=postgresql://user:password@host:port/database